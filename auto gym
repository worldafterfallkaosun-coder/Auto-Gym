-- ══════════════════════════════════════════════════════════
-- EXERCISE DETECTION
-- ══════════════════════════════════════════════════════════
local EX_PATTERNS = {
    -- Compound/specific first
    { p="angkatbeban", t="skillcheck" },
    { p="angkat",      t="skillcheck" },
    { p="beban",       t="skillcheck" },
    { p="dumbbell",    t="skillcheck" },
    { p="barbel",      t="skillcheck" },
    { p="treadmill",   t="treadmill"  },
    { p="lari",        t="treadmill"  },
    { p="cardio",      t="treadmill"  },
    { p="pullup",      t="pullup"     },
    { p="pull%-up",    t="pullup"     },
    { p="chinup",      t="pullup"     },
    { p="chin%-up",    t="pullup"     },
    { p="tarik",       t="pullup"     },
    { p="pushup",      t="skillcheck" },
    { p="push%-up",    t="skillcheck" },
    { p="bench",       t="skillcheck" },
}

local function matchText(text)
    local t = text:lower():gsub("[%s%-_]+","")
    for _, ep in ipairs(EX_PATTERNS) do
        if t:find(ep.p) then return ep.t end
    end
end

local function scanText(root, levelOnly)
    for _, v in ipairs(root:GetChildren()) do
        if v.Visible and (v:IsA("TextLabel") or v:IsA("TextButton")) then
            local t = v.Text
            if not levelOnly or t:lower():find("level") then
                local m = matchText(t)
                if m then return m end
            end
        end
        local r = scanText(v, levelOnly)
        if r then return r end
    end
end

local function detectSkillRingActive()
    if not skillRing then return false end
    return skillRing.Visible and 
           (not pcall(function()
               assert(skillRing.GroupTransparency <= 0.5)
           end) == false)
end

local function scanExercise()
    -- Primary: ring visible = skill check type
    if skillRing and skillRing.Visible then
        -- Distinguish pushup vs angkat by text
        local t = scanText(gymGui, false)
        if t == "treadmill" or t == "pullup" then return t end
        return "skillcheck"
    end
    -- Text scan: level labels first, then any
    local r = scanText(gymGui, true)
    if r then return r end
    return scanText(gymGui, false)
end

-- ── Progress X/Y ───────────────────────────────────────
local function getProgress()
    local function scan(root)
        for _, v in ipairs(root:GetChildren()) do
            if v.Visible and (v:IsA("TextLabel") or v:IsA("TextButton")) then
                local c, m = v.Text:match("(%d+)%s*/%s*(%d+)")
                if c then
                    c, m = tonumber(c), tonumber(m)
                    if m and m >= 5 then return c, m end
                end
            end
            local c, m = scan(v)
            if c then return c, m end
        end
    end
    return scan(gymGui)
end

-- ── TAP button (treadmill tap zones) ──────────────────
local tapBtnCache, tapBtnAge = nil, 0
local function getTapBtn()
    local now = os.clock()
    if tapBtnCache and tapBtnCache.Visible and (now-tapBtnAge)<2 then
        return tapBtnCache
    end
    tapBtnAge = now
    for _, name in ipairs({"TapButton","TapBtn","BtnTap","ButtonTap","Tap"}) do
        local b = gymGui:FindFirstChild(name, true)
        if b and b.Visible then tapBtnCache=b; return b end
    end
    local function scan(root)
        for _, v in ipairs(root:GetChildren()) do
            if (v:IsA("TextButton") or v:IsA("ImageButton")) and v.Visible then
                local ok, t = pcall(function() return v.Text end)
                if ok and t:upper() == "TAP" then return v end
            end
            local r = scan(v); if r then return r end
        end
    end
    tapBtnCache = scan(gymGui)
    return tapBtnCache
end

-- ══════════════════════════════════════════════════════════
-- SKILL CHECK RING
-- ══════════════════════════════════════════════════════════
local function isZoneColor(c)
    return c.R>0.78 and c.G>0.58 and c.B<0.55  -- warm gold / green
        or c.R<0.4  and c.G>0.6  and c.B<0.5   -- green zone
end

local function getZoneRange()
    if not skillRing then return nil, nil end
    local mn, mx = math.huge, -math.huge
    for _, v in ipairs(skillRing:GetChildren()) do
        if v:IsA("Frame") and v ~= needleFrm and isZoneColor(v.BackgroundColor3) then
            local r = v.Rotation % 360
            if r < mn then mn = r end
            if r > mx then mx = r end
        end
    end
    if mn == math.huge then return nil, nil end
    return mn, mx
end

local function skillCheckTick()
    if not MOD.skillcheck.on then return end
    if not skillRing or not skillRing.Visible then MOD.skillcheck.fired=false; return end
    if not needleFrm then needleFrm = findNeedle(skillRing) end
    if not needleFrm then return end

    local now    = os.clock()
    local needle = needleFrm.Rotation % 360
    local zS, zE = getZoneRange()
    if not zS then return end

    local fireAt = (zS - CFG.SC_EARLY) % 360
    local inZone
    if fireAt > zE then
        inZone = needle >= fireAt or needle <= zE
    else
        inZone = needle >= fireAt and needle <= zE
    end

    if inZone and not MOD.skillcheck.fired and (now - MOD.skillcheck.last) > CFG.SC_COOLDOWN then
        MOD.skillcheck.fired = true
        MOD.skillcheck.last  = now
        if pushBtn then fireBtn(pushBtn) end
        task.delay(CFG.SC_COOLDOWN, function() MOD.skillcheck.fired = false end)
    end
end

-- ══════════════════════════════════════════════════════════
-- TREADMILL
-- ══════════════════════════════════════════════════════════
local function startTreadmill()
    if not MOD.treadmill.on or MOD.treadmill.run then return end
    MOD.treadmill.run  = true
    MOD.treadmill.side = false
    task.spawn(function()
        while MOD.treadmill.run do
            tapKey(Enum.KeyCode.Space)
            tapKey(MOD.treadmill.side and Enum.KeyCode.J or Enum.KeyCode.F)
            MOD.treadmill.side = not MOD.treadmill.side
            local tb = getTapBtn()
            if tb then fireBtn(tb) end
            task.wait(CFG.TM_INTERVAL)
        end
    end)
end

local function stopTreadmill()
    MOD.treadmill.run = false
end

-- ══════════════════════════════════════════════════════════
-- PULLUP
-- ══════════════════════════════════════════════════════════
local function startPullup()
    if not MOD.pullup.on or MOD.pullup.run then return end
    MOD.pullup.run  = true
    MOD.pullup.side = false
    task.spawn(function()
        while MOD.pullup.run do
            tapKey(MOD.pullup.side and Enum.KeyCode.J or Enum.KeyCode.F)
            MOD.pullup.side = not MOD.pullup.side
            task.wait(CFG.PU_INTERVAL)
        end
    end)
end

local function stopPullup()
    MOD.pullup.run = false
end

-- ══════════════════════════════════════════════════════════
-- SESSION CONTROL
-- ══════════════════════════════════════════════════════════
local function stopAll(reason)
    if STATE ~= "active" then return end
    stopTreadmill()
    stopPullup()
    curEx    = nil
    nilCount = 0
    STATE    = "cooldown"
    coolEnd  = os.clock() + CFG.COOLDOWN_DUR
    print("[AutoGym] ■ stopped:", reason)
    updateStatus()
end

local function switchEx(ex)
    if ex == curEx then return end
    stopTreadmill()
    stopPullup()
    task.wait(0.08)
    curEx = ex
    print("[AutoGym] → " .. ex:upper())
    updateStatus()
    if ex == "treadmill" then
        startTreadmill()
    elseif ex == "pullup" then
        startPullup()
    elseif ex == "skillcheck" then
        -- handled per-frame in skillCheckTick
    end
end

