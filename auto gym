local function refreshToggles()
    local function upd(btn, on, label)
        if not btn then return end
        if on then
            btn.Text = label .. " ✓"
            btn.BackgroundColor3 = Color3.fromRGB(30, 115, 68)
        else
            btn.Text = label .. " ✗"
            btn.BackgroundColor3 = Color3.fromRGB(85, 35, 35)
        end
    end
    upd(UI.tmBtn, MOD.treadmill.on,  "🏃 Treadmill ")
    upd(UI.puBtn, MOD.pullup.on,     "💪 Pullup      ")
    upd(UI.abBtn, MOD.skillcheck.on, "🏋 Angkat/Push")
end

local function updateStatus()
    if not UI.status then return end
    if STATE == "idle" then
        UI.status.Text = "● idle"
        UI.status.TextColor3 = Color3.fromRGB(100, 100, 120)
    elseif STATE == "active" then
        UI.status.Text = "● " .. (curEx or "active")
        UI.status.TextColor3 = Color3.fromRGB(80, 200, 110)
    elseif STATE == "cooldown" then
        UI.status.Text = "⏳ cooldown"
        UI.status.TextColor3 = Color3.fromRGB(200, 175, 55)
    end
end

-- ── Minimize ──────────────────────────────────────────
local function toggleMin()
    UI.open = not UI.open
    UI.content.Visible = UI.open
    UI.minBtn.Text = UI.open and "−" or "+"
end

-- ── Drag ──────────────────────────────────────────────
local function setupDrag()
    local dragging = false
    local dragStart, panStart

    UI.header.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = inp.Position
            panStart  = UI.panel.Position
            inp.Changed:Connect(function()
                if inp.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch then
            local d = inp.Position - dragStart
            UI.panel.Position = UDim2.new(
                panStart.X.Scale, panStart.X.Offset + d.X,
                panStart.Y.Scale, panStart.Y.Offset + d.Y
            )
        end
    end)
end

-- ── Wire toggle clicks ────────────────────────────────
local function wireUI()
    UI.minBtn.MouseButton1Click:Connect(toggleMin)
    UI.minBtn.TouchTap:Connect(toggleMin)

    local function wired(btn, modKey, label)
        local function toggle()
            MOD[modKey].on = not MOD[modKey].on
            if not MOD[modKey].on then
                if modKey == "treadmill" then stopTreadmill()
                elseif modKey == "pullup" then stopPullup() end
            end
            refreshToggles()
        end
        btn.MouseButton1Click:Connect(toggle)
        btn.TouchTap:Connect(toggle)
    end

    wired(UI.tmBtn, "treadmill",  "🏃 Treadmill ")
    wired(UI.puBtn, "pullup",     "💪 Pullup      ")
    wired(UI.abBtn, "skillcheck", "🏋 Angkat/Push")
end

