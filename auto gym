-- ══════════════════════════════════════════════════════════
-- MAIN LOOP
-- ══════════════════════════════════════════════════════════
local pollLast = 0

RunService.RenderStepped:Connect(function()
    local now = os.clock()

    -- Skill check: every frame for ring precision
    if STATE == "active" and curEx == "skillcheck" then
        skillCheckTick()
    end

    -- Throttle the rest
    if (now - pollLast) < CFG.POLL_RATE then return end
    pollLast = now

    -- Cooldown
    if STATE == "cooldown" then
        if now >= coolEnd then
            STATE = "idle"
            print("[AutoGym] ready")
            updateStatus()
        end
        return
    end

    local ex = scanExercise()

    if STATE == "idle" then
        if ex then
            STATE    = "active"
            curEx    = nil
            nilCount = 0
            print("[AutoGym] session start →", ex)
            switchEx(ex)
            updateStatus()
        end
        return
    end

    -- Active
    if ex then
        nilCount = 0
        switchEx(ex)

        local cur, mx = getProgress()
        if cur and mx and cur >= mx then
            stopAll("done " .. cur .. "/" .. mx)
        end
    else
        nilCount += 1
        if CFG.DEBUG then print("[nil]", nilCount) end
        if nilCount >= CFG.NIL_THRESH then
            stopAll("label gone ×" .. nilCount)
        end
    end
end)

