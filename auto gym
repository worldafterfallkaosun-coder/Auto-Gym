-- ══════════════════════════════════════════════════════════
-- INPUT LAYER
-- ══════════════════════════════════════════════════════════
local function tapKey(kc)
    if not pcall(function()
        keypress(kc.Value); task.wait(0.035); keyrelease(kc.Value)
    end) then
        pcall(function()
            local v = game:GetService("VirtualInputManager")
            v:SendKeyEvent(true, kc, false, game)
            task.wait(0.035)
            v:SendKeyEvent(false, kc, false, game)
        end)
    end
end

local function fireBtn(btn)
    if not btn or not btn.Visible then return end
    if not pcall(function() firesignal(btn.Activated) end) then
        pcall(function()
            local v = game:GetService("VirtualInputManager")
            local p = btn.AbsolutePosition + btn.AbsoluteSize * 0.5
            v:SendMouseButtonEvent(p.X, p.Y, 0, true,  game, 1); task.wait(0.035)
            v:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 1)
        end)
    end
end

-- ══════════════════════════════════════════════════════════
-- GYM GUI DETECTION
-- ══════════════════════════════════════════════════════════
local gymGui, skillRing, pushBtn, needleFrm

local GYM_NAMES = {
    "GymMinigameGui","GymGui","GymUI","MinigameGui",
    "GymGame","GymActivity","MinigameUI","GymHUD",
}

local function findGymGui()
    -- Try known names
    for _, name in ipairs(GYM_NAMES) do
        local g = pg:FindFirstChild(name, true)
        if g and g:IsA("ScreenGui") then return g end
    end
    -- Fallback: scan all ScreenGuis for gym keywords
    for _, v in ipairs(pg:GetChildren()) do
        if v:IsA("ScreenGui") and v ~= pg:FindFirstChild("AutoGymV5") then
            local s = v.Name:lower()
            if s:find("gym") or s:find("minigame") or s:find("exercise") then
                return v
            end
        end
    end
    return nil
end

local function findSkillRing(gui)
    -- Look for SkillCheck or similar ring container
    for _, name in ipairs({"SkillCheck","Ring","SkillRing","MinigameRing","TimingRing"}) do
        local f = gui:FindFirstChild(name, true)
        if f then return f end
    end
    return nil
end

local function findNeedle(ring)
    if not ring then return nil end
    -- Needle: centered anchor, ZIndex 3, rotating
    for _, v in ipairs(ring:GetChildren()) do
        if v:IsA("Frame")
        and math.abs(v.AnchorPoint.X - 0.5) < 0.02
        and math.abs(v.AnchorPoint.Y - 0.5) < 0.02
        and v.ZIndex >= 2
        then
            return v
        end
    end
    -- Fallback: largest ZIndex child
    local best, bz = nil, -1
    for _, v in ipairs(ring:GetChildren()) do
        if v:IsA("Frame") and v.ZIndex > bz then best=v; bz=v.ZIndex end
    end
    return best
end

local function findPushBtn(gui)
    for _, name in ipairs({"PushButton","ActionButton","PressButton","Btn","Button"}) do
        local b = gui:FindFirstChild(name, true)
        if b and (b:IsA("TextButton") or b:IsA("ImageButton")) then return b end
    end
    return nil
end

local function initGymRefs()
    gymGui   = findGymGui()
    if not gymGui then return false end
    skillRing = findSkillRing(gymGui)
    needleFrm = findNeedle(skillRing)
    pushBtn   = findPushBtn(gymGui)
    return true
end

-- Wait for gym GUI
do
    local t = os.clock()
    repeat
        if initGymRefs() then break end
        task.wait(0.2)
    until os.clock()-t > 60
end
