-- ============================================================
--  GYM AUTO v2 — High School Anime | Delta / Roblox (Luau)
--
--  Latihan yang di-handle:
--   * Angkat beban : skill check ring (Space / TAP), baca jarum
--   * Pull Up      : 2 note jatuh (F + J), ditekan pas nyampe tombol
--   * Treadmill    : tap ritme di tombol RunButton
--
--  Yang di-auto (semua latihan):
--   1. Pilih level otomatis (CFG.Level)
--   2. Minigame dimainin otomatis
--   3. Berhenti + keluar otomatis kalau stat "SUDAH MAKSIMAL"
--   4. (opsional) masuk lagi ke mesin yang sama setelah sesi selesai
--   5. (opsional) FAST: pangkas waktu tunggu ring (cuma angkat beban)
--
--  Cara kerja: script cuma nyetir minigame client yang sama kayak
--  pemain, jadi gak ada remote yang dipalsuin.
--   - Ring     : baca zona dari tick, ukur kecepatan jarum per frame,
--                tekan 1 frame sebelum jarum masuk zona.
--   - Pull Up  : tiap note jatuh dari atas ke tombolnya. Kecepatan note
--                diukur dari posisinya per frame, lalu tombol F/J ditekan
--                pas note nyampe (window game +-0.13 detik).
--   - Treadmill: kecepatan lari = jumlah tap dalam 0.8 detik terakhir,
--                jadi bot tap stabil ~TapRate kali/detik + sedikit acak.
--
--  Pakai: berdiri di mesin gym, trigger prompt-nya seperti biasa
--  (atau nyalain AutoReenter), sisanya jalan sendiri.
--  Tombol "GYM BOT" di layar buat ON/OFF. PC: RightShift.
-- ============================================================

local CFG = {
    Level       = 5,      -- 1..5 (5 = paling berat / paling cepat)
    AutoLevel   = true,   -- klik pilih level otomatis
    AutoHit     = true,   -- main minigame otomatis
    StopOnMax   = true,   -- stop bot kalau toast "SUDAH MAKSIMAL"
    ExitOnMax   = true,   -- sekalian keluar dari mesin pas maksimal
    AutoReenter = false,  -- masuk lagi ke mesin terakhir pas sesi selesai
    PressAt     = 0.30,   -- ring: 0..1, posisi tekan di dalam zona (0.3 = agak awal)

    PullLead    = 0.02,   -- pull up: tekan segini (detik) sebelum note nyampe
    TapRate     = 7,      -- treadmill: tap per detik (level 5 butuh minimal ~5)
    TapJitter   = 0.2,    -- treadmill: 0..1, acak jeda antar tap biar gak kaku

    -- FAST (cuma ring/angkat beban): ngepangkas jeda client.
    -- Server mungkin punya batas waktu minimum. Kalau gain gak masuk, matiin.
    Fast        = false,
    FastValues  = { LeadIn = 0.25, GapMin = 0.15, GapMax = 0.30, CompleteHold = 1.0, MissCooldown = 0.3 },
}

local Players        = game:GetService("Players")
local RunService     = game:GetService("RunService")
local UIS            = game:GetService("UserInputService")
local VIM            = game:GetService("VirtualInputManager")
local StarterGui     = game:GetService("StarterGui")

local LP   = Players.LocalPlayer
local PGui = LP:WaitForChild("PlayerGui")

-- ---------- re-execute aman ----------
local env = (getgenv and getgenv()) or _G
if env.__GYMBOT_STOP then pcall(env.__GYMBOT_STOP) end

local alive   = true
local conns   = {}
local enabled = true
local sg

local function track(c) conns[#conns + 1] = c; return c end
env.__GYMBOT_STOP = function()
    alive = false
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    if sg then pcall(function() sg:Destroy() end) end
end

local function notify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = "Gym Bot", Text = text, Duration = 4 })
    end)
    print("[GymBot] " .. text)
end

-- ---------- helper: trigger signal tanpa input asli ----------
local function fire(inst, sigName)
    local sig = inst[sigName or "Activated"]
    if firesignal then
        local ok = pcall(firesignal, sig)
        if ok then return true end
    end
    if getconnections then
        local ok = pcall(function()
            for _, c in ipairs(getconnections(sig)) do c:Fire() end
        end)
        if ok then return true end
    end
    return false
end

-- ---------- helper: "klik" tombol minigame (PullUp / TreadMill) ----------
-- Handler tombol mereka dengerin InputBegan dan cuma baca .UserInputType,
-- jadi input palsu berisi tabel kecil udah cukup. Kalau getconnections
-- gak ada, jatuh ke keyboard virtual (F / J / Space).
local FAKE_INPUT = { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.Begin }
local usedMethod

local function pressGui(btn, key)
    if getconnections then
        local fired = 0
        pcall(function()
            for _, c in ipairs(getconnections(btn.InputBegan)) do
                local ok = pcall(function() c:Fire(FAKE_INPUT) end)
                if ok then fired = fired + 1 end
            end
        end)
        if fired > 0 then
            if usedMethod ~= "connections" then
                usedMethod = "connections"
                print("[GymBot] tekan via getconnections")
            end
            return true
        end
    end
    if key then
        VIM:SendKeyEvent(true,  key, false, game)
        VIM:SendKeyEvent(false, key, false, game)
        if usedMethod ~= "vim" then
            usedMethod = "vim"
            print("[GymBot] tekan via VirtualInputManager (keyboard)")
        end
        return true
    end
    return false
end

-- ---------- tunggu GUI minigame ----------
local gui = PGui:WaitForChild("GymMinigameGui", 30)
if not gui then
    warn("[GymBot] GymMinigameGui gak ketemu. Execute setelah game load penuh.")
    return
end
local sc      = gui:WaitForChild("SkillCheck")
local ls      = gui:WaitForChild("LevelSelect")
local toast   = gui:WaitForChild("GainToast")
local exitBtn = gui:WaitForChild("ExitHolder"):WaitForChild("Exit")

-- rotator = frame 224x224, ZIndex 3 (ring jarum)
local rotator
for _, c in ipairs(sc:GetChildren()) do
    if c:IsA("Frame") and c.Size.X.Offset == 224 and c.ZIndex == 3 then rotator = c; break end
end
if not rotator then warn("[GymBot] rotator ring gak ketemu"); return end

-- ---------- FAST: patch config client (butuh getgc) ----------
if CFG.Fast then
    local patched = false
    if getgc then
        pcall(function()
            for _, t in ipairs(getgc(true)) do
                if type(t) == "table" and rawget(t, "GymFolderName") and rawget(t, "LeadIn") then
                    for k, v in pairs(CFG.FastValues) do t[k] = v end
                    patched = true
                    break
                end
            end
        end)
    end
    notify(patched and "FAST mode aktif" or "FAST gagal (executor gak support getgc)")
end

-- =====================================================================
--  1) RING (angkat beban)
-- =====================================================================
local function press()
    local btn = gui:FindFirstChild("PushButton")
    if btn and fire(btn) then return end
    VIM:SendKeyEvent(true,  Enum.KeyCode.Space, false, game)
    VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end

-- zona = tick yang ukurannya 3x18 (sisanya 2x10)
local function readZone()
    local lo, hi
    for _, c in ipairs(sc:GetChildren()) do
        if c:IsA("Frame") and c.Size.X.Offset == 3 and c.Size.Y.Offset == 18 then
            local a = c.Rotation % 360
            lo = lo and math.min(lo, a) or a
            hi = hi and math.max(hi, a) or a
        end
    end
    return lo, hi
end

local last, pressedThisCheck, zlo, zhi = 0, false, nil, nil

track(RunService.RenderStepped:Connect(function()
    if not alive then return end
    if not enabled or not CFG.AutoHit then return end

    if not sc.Visible or sc.GroupTransparency > 0.9 then
        last, pressedThisCheck, zlo, zhi = 0, false, nil, nil
        return
    end

    local rot = rotator.Rotation % 360
    local d = rot - last            -- derajat per frame
    last = rot

    if d < -1 then                  -- rotation di-reset = ring baru mulai
        pressedThisCheck, zlo, zhi = false, nil, nil
        return
    end
    if d <= 0.01 or pressedThisCheck then return end   -- lead-in / udah ditekan

    if not zlo then
        zlo, zhi = readZone()
        if not zlo then return end
    end

    -- game ngecek input di frame berikutnya, jadi prediksi rot + d
    local width  = math.max(zhi - zlo, 4)
    local target = zlo + width * CFG.PressAt
    if rot + d >= target then
        pressedThisCheck = true
        press()
    end
end))

-- =====================================================================
--  2) PULL UP (note jatuh, lane F dan J)
--  Layer "PullUpLayer": tombol "ButtonF"/"ButtonJ" + note bernama "Note"
--  (clone tombol, Text = F atau J) yang jatuh dari Y=-0.12 ke Y tombol.
--  Satu wave = 1 note per lane; keduanya harus kena (+-0.13 detik).
-- =====================================================================
local PULL_KEYS = { F = Enum.KeyCode.F, J = Enum.KeyCode.J }
local noteInfo  = setmetatable({}, { __mode = "k" })   -- note -> {y, t, done}

track(RunService.RenderStepped:Connect(function()
    if not alive or not enabled or not CFG.AutoHit then return end
    local layer = gui:FindFirstChild("PullUpLayer")
    if not layer then return end

    local now = os.clock()
    for _, note in ipairs(layer:GetChildren()) do
        if note.Name == "Note" and note:IsA("TextButton") then
            local info = noteInfo[note]
            if not info then
                info = { y = note.Position.Y.Scale, t = now, done = false }
                noteInfo[note] = info
            elseif not info.done then
                local y = note.Position.Y.Scale
                if y ~= info.y then
                    local dt = now - info.t
                    local btn = layer:FindFirstChild("Button" .. note.Text)
                    if btn and dt > 0 and y > info.y then
                        local targetY = btn.Position.Y.Scale
                        local speed   = (y - info.y) / dt            -- Y per detik
                        local left    = (targetY - y) / speed        -- detik sampai nyampe
                        local thr     = math.max(CFG.PullLead, dt * 0.5)
                        if left <= thr then
                            info.done = true
                            pressGui(btn, PULL_KEYS[note.Text])
                        end
                    end
                    info.y, info.t = y, now
                end
            end
        end
    end
end))

-- =====================================================================
--  3) TREADMILL (tap ritme)
--  Layer "TreadMillLayer" > Panel > "RunButton". Kecepatan = jumlah tap
--  dalam 0.8 detik terakhir / (0.8 * TapsForMax), jadi tap stabil di atas
--  ~5/detik udah cukup buat kecepatan penuh di semua level.
-- =====================================================================
local rng = Random.new()
task.spawn(function()
    while alive do
        local layer = gui:FindFirstChild("TreadMillLayer")
        local btn = layer and layer:FindFirstChild("RunButton", true)
        if enabled and CFG.AutoHit and btn then
            pressGui(btn, Enum.KeyCode.Space)
            local base = 1 / math.max(CFG.TapRate, 1)
            local j = CFG.TapJitter
            task.wait(base * rng:NextNumber(1 - j * 0.5, 1 + j))
        else
            task.wait(0.2)
        end
    end
end)

-- ---------- auto pilih level ----------
task.spawn(function()
    while alive do
        task.wait(0.25)
        if enabled and CFG.AutoLevel and ls.Visible and ls.GroupTransparency < 0.6 then
            local b = ls:FindFirstChild("Level" .. CFG.Level, true)
            if b then fire(b) end
        end
    end
end)

-- ---------- stop kalau stat maksimal ----------
track(toast:GetPropertyChangedSignal("Text"):Connect(function()
    if not CFG.StopOnMax then return end
    if toast.Text:find("SUDAH MAKSIMAL", 1, true) then
        enabled = false
        if sg then
            local b = sg:FindFirstChildWhichIsA("TextButton")
            if b then b.Text = "GYM BOT: OFF"; b.BackgroundColor3 = Color3.fromRGB(150, 40, 40) end
        end
        notify("Stat sudah maksimal, bot berhenti.")
        if CFG.ExitOnMax then fire(exitBtn) end
    end
end))

-- ---------- auto masuk lagi (opsional) ----------
local lastPrompt
local function hookPrompt(p)
    if p:IsA("ProximityPrompt") then
        track(p.Triggered:Connect(function(plr)
            if plr == LP then lastPrompt = p end
        end))
    end
end
local gym = workspace:FindFirstChild("GYM")
if gym then
    for _, d in ipairs(gym:GetDescendants()) do hookPrompt(d) end
    track(gym.DescendantAdded:Connect(hookPrompt))
end

local function hookChar(c)
    track(c:GetAttributeChangedSignal("IsGymming"):Connect(function()
        if c:GetAttribute("IsGymming") == false and enabled and CFG.AutoReenter
           and lastPrompt and lastPrompt.Parent then
            task.wait(1.5)
            if alive and enabled and not c:GetAttribute("IsGymming") and fireproximityprompt then
                pcall(fireproximityprompt, lastPrompt)
            end
        end
    end))
end
if LP.Character then hookChar(LP.Character) end
track(LP.CharacterAdded:Connect(hookChar))

-- ---------- tombol ON/OFF ----------
sg = Instance.new("ScreenGui")
sg.Name = "GymBotUI"
sg.ResetOnSpawn = false
sg.DisplayOrder = 999
local okParent = pcall(function()
    sg.Parent = (gethui and gethui()) or game:GetService("CoreGui")
end)
if not okParent or not sg.Parent then
    -- game nge-skip ScreenGui bernama "TouchGui" pas nyembunyiin UI saat gym
    sg.Name = "TouchGui"
    sg.Parent = PGui
end

local btn = Instance.new("TextButton")
btn.Size = UDim2.fromOffset(104, 30)
btn.Position = UDim2.new(0, 10, 0.35, 0)
btn.BackgroundColor3 = Color3.fromRGB(30, 130, 60)
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 12
btn.Text = "GYM BOT: ON"
btn.BorderSizePixel = 0
btn.Parent = sg
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

local function setEnabled(v)
    enabled = v
    btn.Text = v and "GYM BOT: ON" or "GYM BOT: OFF"
    btn.BackgroundColor3 = v and Color3.fromRGB(30, 130, 60) or Color3.fromRGB(150, 40, 40)
end

track(btn.Activated:Connect(function() setEnabled(not enabled) end))
track(UIS.InputBegan:Connect(function(i, g)
    if g then return end
    if i.KeyCode == Enum.KeyCode.RightShift then setEnabled(not enabled) end
end))

notify(string.format("Aktif | Level %d | AutoHit %s | Fast %s",
    CFG.Level, tostring(CFG.AutoHit), tostring(CFG.Fast)))
