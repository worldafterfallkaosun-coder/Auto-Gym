local CFG = {
    SC_EARLY     = 6,    -- degrees ahead of zone to fire ring
    SC_COOLDOWN  = 0.20, -- seconds between ring presses
    TM_INTERVAL  = 0.09, -- treadmill key interval
    PU_INTERVAL  = 0.10, -- pullup key interval
    POLL_RATE    = 0.18, -- exercise detection poll rate
    NIL_THRESH   = 4,    -- consecutive nil polls → end session
    COOLDOWN_DUR = 3.2,  -- seconds blocked after session end
    DEBUG        = false,
}

